                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Islamic_Medium"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Islamic/Medium/Drawn</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Islamic_Large"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Islamic/Large/Drawn</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Christian_Small"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Christian/Small/Drawn</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Christian_Medium"]/graphicData/texPath</xpath>
