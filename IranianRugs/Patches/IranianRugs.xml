                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Islamic_Small"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Islamic/Small/Photo</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Islamic_Medium"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Islamic/Medium/Photo</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Islamic_Large"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Islamic/Large/Photo</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Christian_Small"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Christian/Small/Photo</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Christian_Medium"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Christian/Medium/Photo</texPath></value>
                </li>
                <li Class="PatchOperationReplace">
                  <success>Always</success>
                  <xpath>Defs/ThingStyleDef[defName="IranianRugs_Christian_Large"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Styles/Christian/Large/Photo</texPath></value>
                </li>
              </operations>
            </match>
          </li>
        </operations>
      </li>
      <li>
        <id>IranianRugs_Look_Drawn</id>
        <label>Drawn designs</label>
        <tooltip>The drawn designs from before version 1.3.0 (35 of them), tinted by the cloth or leather the rug is made from.</tooltip>
        <defaultValue>False</defaultValue>
        <operations>
          <li Class="PatchOperationFindMod">
            <mods>
              <li>Vanilla Furniture Expanded - Art</li>
            </mods>
            <match Class="PatchOperationSequence">
              <operations>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="VFE_RugSmall"]/graphicData/texPath</xpath>
                  <value><texPath>IranianRugs/Small/Drawn</texPath></value>
