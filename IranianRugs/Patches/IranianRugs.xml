<?xml version="1.0" encoding="utf-8"?>
<!-- VFE - Art's rugs as handwoven rugs (photos of real carpets, see Source/carpet_sources.json; in game they keep VFE's names): several designs per size, one picked at random per rug (Graphic_Random),
     and a CutoutComplex mask: the masks are all black, so every rug keeps the photo's own colours (material colour not used).
     Sizes, stats and recipes are untouched. Does nothing if VFE - Art isn't loaded. -->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Furniture Expanded - Art</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugSmall"]/graphicData</xpath>
          <value>
            <graphicData>
              <graphicClass>Graphic_Random</graphicClass>
              <texPath>IranianRugs/Small</texPath>
              <shaderType>CutoutComplex</shaderType>
              <drawSize>(2,2)</drawSize>
            </graphicData>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugLarge"]/graphicData</xpath>
          <value>
            <graphicData>
              <graphicClass>Graphic_Random</graphicClass>
              <texPath>IranianRugs/Medium</texPath>
              <shaderType>CutoutComplex</shaderType>
              <drawSize>(3,3)</drawSize>
            </graphicData>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugGrand"]/graphicData</xpath>
          <value>
            <graphicData>
              <graphicClass>Graphic_Random</graphicClass>
              <texPath>IranianRugs/Large</texPath>
              <shaderType>CutoutComplex</shaderType>
              <drawSize>(4,4)</drawSize>
            </graphicData>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugSmall"]/description</xpath>
          <value><description>A small handwoven rug, copied from a photo of a real antique carpet: city medallion, prayer, Herat vine and palmette, garden, boteh, vase, Heriz, Turkmen, Qashqai kilim, Gabbeh, kilim or Baluch.</description></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugLarge"]/description</xpath>
          <value><description>A large handwoven rug, copied from a photo of a real antique carpet: city medallion, prayer, Herat vine and palmette, garden, boteh, vase, Heriz, Turkmen, Qashqai kilim, Gabbeh, kilim or Baluch.</description></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugGrand"]/description</xpath>
          <value><description>A grand handwoven rug that dominates a room, copied from a photo of a real antique carpet: city medallion, prayer, Herat vine and palmette, garden, boteh, vase, Heriz, Turkmen, Qashqai kilim, Gabbeh, kilim or Baluch.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
