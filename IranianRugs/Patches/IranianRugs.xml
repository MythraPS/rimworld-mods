<?xml version="1.0" encoding="utf-8"?>
<!-- VFE - Art's rugs as handwoven rugs (in game they keep VFE's names): photos of real carpets (Photo/, see Source/carpet_sources.json) and drawn designs (Drawn/),
     one picked at random per rug (HandwovenRugs.Graphic_RugFolders reads both subfolders). CutoutComplex masks: the photos' are all black, so they keep their own colours; the drawn ones' let the
     cloth or leather tint the field. The "Rug pictures" mod setting at the end of this file can narrow it to one set; it must stay in this file, after the replace.
     Sizes, stats and recipes are untouched. Does nothing if VFE - Art isn't loaded. -->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Furniture Expanded - Art</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugSmall"]/graphicData</xpath>
          <value>
            <graphicData>
              <graphicClass>HandwovenRugs.Graphic_RugFolders</graphicClass>
              <texPath>IranianRugs/Small</texPath>
              <shaderType>CutoutComplex</shaderType>
              <drawSize>(2,2)</drawSize>
            </graphicData>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugLarge"]/graphicData</xpath>
          <value>
            <graphicData>
              <graphicClass>HandwovenRugs.Graphic_RugFolders</graphicClass>
              <texPath>IranianRugs/Medium</texPath>
              <shaderType>CutoutComplex</shaderType>
              <drawSize>(3,3)</drawSize>
            </graphicData>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugGrand"]/graphicData</xpath>
          <value>
            <graphicData>
              <graphicClass>HandwovenRugs.Graphic_RugFolders</graphicClass>
              <texPath>IranianRugs/Large</texPath>
              <shaderType>CutoutComplex</shaderType>
              <drawSize>(4,4)</drawSize>
            </graphicData>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugSmall"]/description</xpath>
          <value><description>A small handwoven rug: either a photo of a real antique carpet or a drawn design in the same weaving traditions (city medallion, prayer, Herat vine and palmette, garden, boteh, vase, Heriz, Turkmen, Qashqai kilim, Gabbeh, kilim or Baluch).</description></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugLarge"]/description</xpath>
          <value><description>A large handwoven rug: either a photo of a real antique carpet or a drawn design in the same weaving traditions (city medallion, prayer, Herat vine and palmette, garden, boteh, vase, Heriz, Turkmen, Qashqai kilim, Gabbeh, kilim or Baluch).</description></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="VFE_RugGrand"]/description</xpath>
          <value><description>A grand handwoven rug that dominates a room: either a photo of a real antique carpet or a drawn design in the same weaving traditions (city medallion, prayer, Herat vine and palmette, garden, boteh, vase, Heriz, Turkmen, Qashqai kilim, Gabbeh, kilim or Baluch).</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <!-- rug pictures setting (written by Source/make_look.py) -->
  <Operation Class="ModSettingsFramework.PatchOperationRadioButtons">
    <id>IranianRugs_Look</id>
    <label>Rug pictures</label>
    <tooltip>Which pictures the rugs use. Changes right away, rugs already built too.</tooltip>
    <category>IranianRugs_General</category>
    <order>5</order>
    <options>
      <li>
        <id>IranianRugs_Look_Both</id>
        <label>Both</label>
        <tooltip>Every rug picks at random from the photos and the drawn designs together.</tooltip>
        <defaultValue>True</defaultValue>
        <operations>
          <li Class="PatchOperationFindMod">
            <mods>
              <li>Vanilla Furniture Expanded - Art</li>
            </mods>
            <match Class="PatchOperationSequence">
              <operations>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="VFE_RugSmall"]/description</xpath>
                  <value><description>A small handwoven rug: either a photo of a real antique carpet or a drawn design in the same weaving traditions (city medallion, prayer, Herat vine and palmette, garden, boteh, vase, Heriz, Turkmen, Qashqai kilim, Gabbeh, kilim or Baluch).</description></value>
                </li>
                <li Class="PatchOperationReplace">
                  <xpath>Defs/ThingDef[defName="VFE_RugLarge"]/description</xpath>
