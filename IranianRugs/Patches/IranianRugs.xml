                </li>
              </operations>
            </match>
          </li>
        </operations>
      </li>
      <li>
        <id>IranianRugs_Look_Photo</id>
        <label>Photos of real carpets</label>
        <tooltip>Rugs are photos of 22 real antique carpets, in the carpets' own colours.</tooltip>
        <defaultValue>False</defaultValue>
        <operations>
          <li Class="PatchOperationFindMod">
            <mods>
              <li>Vanilla Furniture Expanded - Art</li>
