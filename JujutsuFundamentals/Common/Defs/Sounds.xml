<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- Black Flash: vanilla clips, as in Sukuna's mod. -->
  <SoundDef>
    <defName>JJK_Snd_BlackFlash</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/BladelinkZeusHammer</clipFolderPath>
          </li>
        </grains>
        <volumeRange>40~40</volumeRange>
        <pitchRange>0.665~0.735</pitchRange>
      </li>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/PunchHitPawn</clipFolderPath>
          </li>
        </grains>
        <volumeRange>35~35</volumeRange>
        <pitchRange>0.57~0.63</pitchRange>
      </li>
      <li MayRequire="Ludeon.RimWorld.Anomaly">
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Building/VoidMonolith/Activation/Zap</clipFolderPath>
          </li>
        </grains>
        <volumeRange>30~30</volumeRange>
        <pitchRange>0.57~0.63</pitchRange>
      </li>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Misc/Psycasts/Psycast_Psychic_Pulse</clipFolderPath>
          </li>
        </grains>
        <volumeRange>18~18</volumeRange>
        <pitchRange>1.71~1.89</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Boogie Woogie's clap and the vibraslap's rattle: vanilla clips, placeholders. -->
  <SoundDef>
    <defName>JJK_Snd_Clap</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/PunchHitPawn</clipFolderPath>
          </li>
        </grains>
        <volumeRange>30~30</volumeRange>
        <pitchRange>1.5~1.7</pitchRange>
      </li>
    </subSounds>
  </SoundDef>
  <SoundDef>
    <defName>JJK_Snd_Vibraslap</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/PunchHitPawn</clipFolderPath>
          </li>
        </grains>
        <volumeRange>26~26</volumeRange>
        <pitchRange>2.4~2.8</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Cursed Energy Blast letting go: vanilla clips, placeholder. -->
  <SoundDef>
    <defName>JJK_Snd_Blast</defName>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Misc/Psycasts/Psycast_Psychic_Pulse</clipFolderPath>
          </li>
        </grains>
        <volumeRange>30~30</volumeRange>
        <pitchRange>0.6~0.7</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Air Step: as in the Sukuna mod (vanilla skip exit, pitched up). -->
  <SoundDef>
    <defName>JJK_Snd_AirStep</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Misc/Psycasts/Skip/Exit</clipFolderPath>
          </li>
        </grains>
        <volumeRange>18~18</volumeRange>
        <pitchRange>1.425~1.575</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
