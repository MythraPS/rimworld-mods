  <!-- The Prison Realm (her calls): works like a psychic lance, or is planted like a mine. Seals one person after
       a short wind-up and puts them out of play until released. Only one in a game, holding one person. -->
  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>JJK_PrisonRealm</defName>
    <label>Prison Realm</label>
    <description>A cursed object that seals one person inside it, out of play with all their abilities, until it is opened. Aim it at someone in range, or plant it like a mine: the first enemy to come close is sealed if they are still near when it finishes opening. There is only one, and it holds only one person.</description>
    <thingClass>JujutsuFundamentals.Apparel_PrisonRealm</thingClass>
    <graphicData>
      <texPath>Things/Jujutsu/Tools/PrisonRealm</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Archotech</techLevel>
    <tradeability>Sellable</tradeability>
    <tradeTags>
      <li>JJK_CursedTool</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
      <li>JJK_CursedTool</li>
    </thingSetMakerTags>
    <statBases>
      <Mass>0.6</Mass>
      <EquipDelay>1</EquipDelay>
      <MarketValue>6000</MarketValue>
      <MaxHitPoints>500</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <tickerType>Normal</tickerType>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
    <tradeNeverStack>true</tradeNeverStack>
    <smeltable>false</smeltable>
    <burnableByRecipe>false</burnableByRecipe>
    <drawGUIOverlay>false</drawGUIOverlay>
    <verbs>
      <li>
        <verbClass>JujutsuFundamentals.Verb_PrisonRealm</verbClass>
        <label>Prison Realm</label>
        <hasStandardCommand>true</hasStandardCommand>
        <targetable>true</targetable>
        <onlyManualCast>True</onlyManualCast>
        <range>15.9</range>
        <warmupTime>3</warmupTime>
        <targetParams>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
        </targetParams>
        <soundAiming>PsychicArtifactWarmupSustained</soundAiming>
