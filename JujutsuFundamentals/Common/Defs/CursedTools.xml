  <!-- ===================================================================== Heavenly Restriction -->

  <TraitDef>
    <defName>JJK_HeavenlyRestriction</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>heavenly restriction: zero cursed energy</label>
        <description>[PAWN_nameDef] was born with no cursed energy at all. In exchange, [PAWN_pronoun] has a superhuman body. [PAWN_pronoun] has no psychic sensitivity, can never use psycasts, and a domain's sure hit can't lock onto [PAWN_objective].</description>
        <statFactors>
          <PsychicSensitivity>0</PsychicSensitivity>
        </statFactors>
      </li>
      <!-- Yuji after his first eaten finger (her call 2026-11-10): the restriction is not lifted, it stays, but a
           loophole bypasses it. -->
      <li>
        <degree>1</degree>
        <label>heavenly restriction: zero cursed energy (bypassed)</label>
        <description>[PAWN_nameDef] was born with no cursed energy at all, and with a superhuman body in exchange. The restriction is still there, but a loophole bypasses it: [PAWN_pronoun] has cursed energy, psychic sensitivity and psycasts all the same, and a domain's sure hit can reach [PAWN_objective].</description>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- The superhuman body (her call 2026-11-10: Yuji's abnormal physique and the Heavenly Restriction body are the
       same thing, with the same effects for Toji, Maki, Yuji and Modulo Yuji). Yuji's physique numbers (already tuned,
       melee x2.5 her call 11-06) plus the restriction's extras (senses, healing, immunity, toxin resistance). -->
  <HediffDef>
    <defName>JJK_ZeroCursedEnergyBody</defName>
    <label>superhuman body</label>
    <description>A body far beyond human: stronger, very fast, far tougher and sharper-sensed than anyone trained could be. Blows land at half force, skin turns blades and blunt hits, wounds bleed slowly and heal very fast, and pain barely stops it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.55, 0.65)</defaultLabelColor>
    <isBad>false</isBad>
