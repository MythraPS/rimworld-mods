       shattering into shards from the point of impact). Art: tools/yuta/art_sky_crack.py. -->
  <FleckDef Name="JJK_SkyCrackBase" ParentName="FleckBase" Abstract="True">
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.04</fadeInTime>
