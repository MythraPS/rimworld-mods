<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- Death Painting quests: the finger quests (Events.xml) with a painting in the stash.
       Started only by IncidentWorker_PaintingRumour, which puts the painting in the slate. -->
  <QuestScriptDef Abstract="True" Name="Sukuna_PaintingQuestBase">
    <rootSelectionWeight>0</rootSelectionWeight>
    <autoAccept>true</autoAccept>
  </QuestScriptDef>

  <QuestScriptDef ParentName="Sukuna_PaintingQuestBase">
    <defName>Sukuna_Painting_Ruin</defName>
    <questNameRules>
      <rulesStrings>
        <li>questName->The [sealed] Painting</li>
        <li>sealed->Sealed</li>
        <li>sealed->Buried</li>
        <li>sealed->Forgotten</li>
        <li>sealed->Warded</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->Something has been left to rot in a ruin not far from [map_definite]: a jar of black glass, and inside it one of the Death Paintings, a cursed womb that has been half alive for a hundred and fifty years.\n\nWhoever reaches it first gets to decide what happens to it.\n\nIt seems that [allSitePartsDescriptionsExceptFirst]</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript"><def>Util_RandomizePointsChallengeRating</def></li>
        <li Class="QuestNode_SubScript"><def>Util_AdjustPointsForDistantFight</def></li>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li><tag>ItemStash</tag></li>
            <li><tag>Sukuna_RuinThreat</tag></li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
          <parms><hiddenSitePartsPossible>true</hiddenSitePartsPossible></parms>
        </li>
        <li Class="QuestNode_SpawnWorldObjects"><worldObjects>$site</worldObjects></li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(15,25)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label>Painting lost: [resolvedQuestName]</label>
                <text>Someone else reached the painting first. It will turn up somewhere else.</text>
              </li>
              <li Class="QuestNode_End"><outcome>Fail</outcome></li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_NoWorldObject">
          <worldObject>$site</worldObject>
          <node Class="QuestNode_End" />
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <QuestScriptDef ParentName="Sukuna_PaintingQuestBase">
    <defName>Sukuna_Painting_Held</defName>
    <questNameRules>
      <rulesStrings>
        <li>questName->The Painting in [siteFaction_name]'s Keeping</li>
        <li>questName->[siteFaction_name]'s Trophy</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[siteFaction_name] have one of the Death Paintings, sealed in a jar, in a fortified outpost not far from [map_definite]. They think it is a medicine.\n\nThey will not hand it over. Take it.\n\nIt seems that [allSitePartsDescriptionsExceptFirst]</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript"><def>Util_RandomizePointsChallengeRating</def></li>
        <li Class="QuestNode_SubScript"><def>Util_AdjustPointsForDistantFight</def></li>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li><tag>ItemStash</tag></li>
            <li><tag>Sukuna_HeldThreat</tag></li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="QuestNode_SpawnWorldObjects"><worldObjects>$site</worldObjects></li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(20,30)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label>Painting lost: [resolvedQuestName]</label>
                <text>[siteFaction_name] have moved the painting somewhere else, or sold it. It will turn up again.</text>
              </li>
              <li Class="QuestNode_End"><outcome>Fail</outcome></li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_NoWorldObject">
          <worldObject>$site</worldObject>
          <node Class="QuestNode_End" />
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <QuestScriptDef ParentName="Sukuna_PaintingQuestBase">
    <defName>Sukuna_Painting_Convoy</defName>
    <questNameRules>
      <rulesStrings>
        <li>questName->The Painting on the Road</li>
        <li>questName->[siteFaction_name]'s Cargo</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->A caravan from [siteFaction_name] is carrying one of the Death Paintings to a collector far away. It has stopped for the night not far from [map_definite].\n\nIt will not stay long. If you want the painting, catch them before they move on.\n\nIt seems that [allSitePartsDescriptionsExceptFirst]</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript"><def>Util_RandomizePointsChallengeRating</def></li>
        <li Class="QuestNode_SubScript"><def>Util_AdjustPointsForDistantFight</def></li>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_GetSiteTile">
          <storeAs>siteTile</storeAs>
          <preferCloserTiles>true</preferCloserTiles>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li><tag>ItemStash</tag></li>
            <li><tag>Sukuna_HeldThreat</tag></li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
        </li>
        <li Class="QuestNode_SpawnWorldObjects"><worldObjects>$site</worldObjects></li>
        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$site</worldObject>
          <isQuestTimeout>true</isQuestTimeout>
          <delayTicks>$(randInt(3,5)*60000)</delayTicks>
          <inSignalDisable>site.MapGenerated</inSignalDisable>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label>Painting lost: [resolvedQuestName]</label>
                <text>The caravan from [siteFaction_name] has broken camp and moved on with the painting.</text>
              </li>
              <li Class="QuestNode_End"><outcome>Fail</outcome></li>
            </nodes>
          </node>
        </li>
        <li Class="QuestNode_NoWorldObject">
          <worldObject>$site</worldObject>
          <node Class="QuestNode_End" />
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
