<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- The shrine itself. Purely a presence — all damage comes from the domain.
       It despawns when the domain ends. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Sukuna_ShrineBuilding</defName>
    <label>malevolent shrine</label>
    <description>A shrine of bone and dark timber that was not built and will not remain. While it stands, everything around it is being cut.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Sukuna/MalevolentShrine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(5, 5)</drawSize>
      <shadowData>
        <volume>(2.6, 1.2, 2.0)</volume>
      </shadowData>
    </graphicData>
    <size>(3,3)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <blockLight>false</blockLight>
    <holdsRoof>false</holdsRoof>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <isSaveable>true</isSaveable>
    <blockWind>false</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>


  <!-- Skulls heaped around the shrine. Purely presence; removed with it.
       Horned beast skulls, drawn for this mod in three variants. They have to be
       drawn: RimWorld and every one of its DLCs ship exactly one skull asset, the
       human Skull item, and this heap is not supposed to be human. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Sukuna_ShrineBone</defName>
    <label>heaped skulls</label>
    <description>The skulls of horned beasts, forced up out of the ground around the shrine. They go back down with it.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Sukuna/BeastSkull</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1.3, 1.3)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <!-- One layer below the shrine (Building), so skulls under it peek out of its
         clear parts instead of covering it. -->
    <altitudeLayer>DoorMoveable</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>14</pathCost>
    <fillPercent>0.2</fillPercent>
    <useHitPoints>false</useHitPoints>
    <destroyable>false</destroyable>
    <selectable>false</selectable>
    <rotatable>false</rotatable>
    <isSaveable>true</isSaveable>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

</Defs>
