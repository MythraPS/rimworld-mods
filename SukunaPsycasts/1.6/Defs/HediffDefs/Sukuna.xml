<Defs>

  <!-- ===================================================================
       SukunaVessel — the marker every other system reads.
       Severity == number of fingers this pawn has eaten. Each stage adds
       psychic sensitivity, which is what every ability in the path scales on.
       =================================================================== -->
  <HediffDef>
