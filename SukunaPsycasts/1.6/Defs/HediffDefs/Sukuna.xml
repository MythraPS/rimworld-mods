  <!-- ===================================================================
       L2 · Slash Defense: Thorns
       Mechanically VPE_FireShield with Cut instead of Flame, and no absorb.
       =================================================================== -->
  <HediffDef>
    <defName>Sukuna_ThornsShield</defName>
    <label>slash defense: thorns</label>
    <description>A lattice of standing cuts held just off the skin. Whoever hits this person in melee is cut in return, every time a blow lands.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="VEF.Hediffs.HediffCompProperties_Shield">
        <compClass>VEF.Hediffs.HediffComp_Shield</compClass>
        <absorbAttackType>None</absorbAttackType>
        <damageOnAttack>Melee</damageOnAttack>
        <damageType>Sukuna_Slash</damageType>
        <damageAmount>8</damageAmount>
        <armorPenetration>0.4</armorPenetration>
        <doDust>false</doDust>
      </li>
    </comps>
  </HediffDef>

  <!-- ===================================================================
       L2 · Cursed Energy Reinforcement (was Slash Defense: Pseudo-Infinity;
       defName kept so saves keep it). PASSIVE once learned; the toggle sets
       Boosted (double output). The class builds its stage live from
       Scaling.Power: armour, melee damage, move speed; Furnace adds heat.
       =================================================================== -->
  <HediffDef>
    <defName>Sukuna_PseudoInfinity</defName>
    <label>cursed energy reinforcement</label>
    <description>Cursed energy coats the body, hardening the skin, putting more weight behind every blow and quickening every step. Always on; raising the output doubles it. Grows stronger with each finger.</description>
    <hediffClass>SukunaPsycasts.Hediff_CursedEnergyReinforcement</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <label>reinforced</label>
      </li>
    </stages>
  </HediffDef>

  <!-- ===================================================================
       L3 · Reverse Cursed Technique — PASSIVE.
       No duration comp: this is maintained by HediffComp_VesselPassives for
       as long as the pawn has the ability unlocked. Its speed is read from
       the psyfocus pool every tick, and it stops dead at 0 psyfocus or at
       maximum neural heat.
       =================================================================== -->
  <HediffDef>
    <defName>Sukuna_ReverseCursedTechnique</defName>
    <label>reverse cursed technique</label>
    <description>Cursed energy turned back against itself and multiplied, producing an output that does the opposite of what it was made to do. Wounds close on their own, at whatever speed there is energy to close them.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="SukunaPsycasts.HediffCompProperties_ReverseCursedTechnique">
        <selfHealPerTickAtFullPsyfocus>1.5</selfHealPerTickAtFullPsyfocus>   <!-- per second at full psyfocus; was 0.06 (her call 2026-11-07: much stronger) -->
        <allyHealFraction>0.35</allyHealFraction>
        <allyRadius>3.9</allyRadius>
        <psyfocusPerTick>0.00012</psyfocusPerTick>
        <entropyPerTick>0.05</entropyPerTick>
      </li>
    </comps>
  </HediffDef>

  <!-- ===================================================================
       L3 · Black Flash — PASSIVE, also maintained by the vessel comp.
       =================================================================== -->
  <HediffDef>
    <defName>Sukuna_BlackFlash</defName>
    <label>black flash</label>
    <description>Cursed energy arriving within a millionth of a second of the blow itself. Nobody does it on purpose. It happens, and when it happens the space around the impact goes black.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="SukunaPsycasts.HediffCompProperties_BlackFlash">
        <baseChance>0.03</baseChance>
        <damageMultiplier>2.5</damageMultiplier>
        <armorPenetrationBonus>0.50</armorPenetrationBonus>
        <armorPenetrationBonusMax>1.00</armorPenetrationBonusMax>
        <armorPenetrationCeiling>1.90</armorPenetrationCeiling>
        <lifestealFraction>0.30</lifestealFraction>
        <psyfocusRestored>0.05</psyfocusRestored>
        <entropyPurged>12</entropyPurged>
      </li>
    </comps>
  </HediffDef>

  <!-- ===================================================================
       L3 · Domain Expansion: Malevolent Shrine — the caster-borne aura.
       armorPenetration matches Dismantle exactly; the Domain is Dismantle
       thrown many times, not a different technique.
       =================================================================== -->
  <HediffDef>
    <defName>Sukuna_MalevolentShrine</defName>
    <label>malevolent shrine</label>
    <description>An open domain. There is no barrier and no shell — the binding vow traded those away for reach, and the reach is enormous.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="SukunaPsycasts.HediffCompProperties_MalevolentShrine">
        <damageAmount>12</damageAmount>
        <ticksBetween>30</ticksBetween>
        <radius>24.9</radius>
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>


  <!-- Black Flash (her call 2026-11-07): a black star with a red rim and red cracks bursting out
       of the hit, growing (tools/art_blackflash.py). -->
  <FleckDef ParentName="FleckBase">
    <defName>Sukuna_Fleck_BlackFlashBurst</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.12</solidTime>
    <fadeOutTime>0.4</fadeOutTime>
    <growthRate>4</growthRate>
    <graphicData>
      <texPath>Things/Sukuna/BlackFlashBurst</texPath>
      <graphicClass>Graphic_Fleck</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
  </FleckDef>

  <!-- After a Black Flash the sorcerer is "in the zone" for a few seconds: sharper in melee, and
       the next Black Flash comes easier (x1.5 chance, in the code), as when Yuji chains them. -->
  <HediffDef>
    <defName>Sukuna_BlackFlashZone</defName>
    <label>in the zone</label>
    <description>Right after a Black Flash, cursed energy flows perfectly for a few seconds. They hits more surely in melee, and another Black Flash comes easier.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.86, 0.15, 0.18)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>0.15</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
